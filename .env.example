# Copy to .env and fill in. Never commit .env.
# One key per provider. A comma-separated list is accepted and rotated round-robin,
# but do NOT create extra accounts/projects to multiply free limits.

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model lanes (verify names in each console during the smoke tests)
LLM_LANE_1=gemini:gemini-3.8-flash
LLM_LANE_2=gemini:gemini-3.6-flash
LLM_LANE_3=groq:openai/gpt-oss-120b
LLM_LANE_4=openrouter:REPLACE_WITH_A_FREE_MODEL_THAT_LISTS_TOOL_SUPPORT
LLM_LIGHT_MODEL=gemini-3.5-flash-lite

# Sarvam (Rs 100 free credit)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_BUDGET_INR=100
SARVAM_STOP_AT_INR_LEFT=10

# Twilio WhatsApp sandbox (trial, ~100 messages)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=whsec_

# Server
PUBLIC_BASE_URL=https://REPLACE.ngrok-free.app
NGROK_AUTHTOKEN=
MONGO_URI=mongodb://localhost:27017
MONGO_DB=resolveai
PRODUCT_NAME=ResolveAI
AUTO_REFUND_LIMIT_INR=2000
